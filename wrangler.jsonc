{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pizzatycoon",
  "main": "worker/src/index.ts",
  // `wrangler deploy` builds the game first, so Cloudflare Workers Builds needs no separate build command.
  "build": { "command": "npm run build" },
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pizza-d-saves",
      // No database_id: wrangler creates the database on the first deploy and remembers it.
      "migrations_dir": "worker/migrations"
    }
  ],
  "observability": { "enabled": true }
}
